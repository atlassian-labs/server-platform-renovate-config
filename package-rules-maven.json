{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchPackagePatterns": [
        "commons-httpclient:commons-httpclient",
        "jaxen:jaxen",
        "log4j:log4j",
        "opensymphony:oscore",
        "org.apache.velocity:velocity",
        "^org.codehaus.jackson",
        "^org.eclipse.gemini.blueprint"
      ],
      "allowedVersions": "/.+[0-9]+-atlassian-[0-9]+$/"
    },
    {
      "matchPackagePatterns": [
        "^com.atlassian",
        "net.java.dev.activeobjects"
      ],
      "allowedVersions": "/^[0-9]{1,3}\\.[0-9]+\\.[0-9]+(\\.[0-9]+)?$/"
    },
    {
      "matchPackagePatterns": [
        "com.google.code.findbugs:annotations",
        "biz.aQute.bnd:biz.aQute.bndlib",
        "io.atlassian.util.concurrent:atlassian-util-concurrent"
      ],
      "allowedVersions": "/^[0-9]+\\.[0-9]+\\.[0-9]+(\\.[0-9]+)?$/"
    },
    {
      "description": "Artifactory's maven-internal virtual repo proxies HeroDevs NES, whose builds are versioned <base>-<project>-<version>[-trial], e.g. 6.2.19-spring-framework-6.2.20-trial. Maven ranks unknown qualifiers above the bare release, so without this Renovate offers them as patch upgrades.",
      "matchPackageNames": [
        "org.springframework:*",
        "org.springframework.security:*",
        "org.springframework.ldap:*"
      ],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+(-atlassian-\\d+)?$/"
    },
    {
      "matchPackageNames": [
        "org.springframework:org.springframework.beans",
        "org.springframework:org.springframework.context"
      ],
      "allowedVersions": "!/2.5.6/"
    },
    {
      "matchPackageNames": ["org.springframework.*"],
      "updateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackageNames": ["com.microsoft.sqlserver:mssql-jdbc"],
      "allowedVersions": "/jre8$/"
    },
    {
      "matchPackageNames": ["commons-io:commons-io"],
      "allowedVersions": "!/1.4-backport-IO-168/"
    },
    {
      "matchPackageNames": ["javax.servlet:servlet-api"],
      "allowedVersions": "!/2.4-20040521/"
    },
    {
      "matchPackageNames": ["c3p0:c3p0"],
      "allowedVersions": "!/0.9.1.2-pbruski/"
    },
    {
      "matchPackageNames": ["com.sun.jersey:jersey-client"],
      "allowedVersions": "!/.+-ea/"
    },
    {
      "matchPackageNames": ["javax.xml.bind:jaxb-api"],
      "allowedVersions": "/^[0-9]+\\.[0-9]+(\\.[0-9]+)?$/"
    },
    {
      "matchPackageNames": ["jakarta.inject:jakarta.inject-api"],
      "allowedVersions": "/^[0-9]+\\.[0-9]+\\.[0-9]+$/"
    },
    {
      "matchPackageNames": ["org.reflections:reflections"],
      "allowedVersions": "!/^0.9.12$/"
    },
    {
      "matchPackageNames": ["com.google.guava:guava"],
      "versioning": "regex:^(?<major>\\d+)(\\.(?<minor>\\d+))?(\\.(?<patch>\\d+))?(-(?<compatibility>.*))?$"
    },
    {
      "matchPackageNames": ["com.github.eirslett:frontend-maven-plugin"],
      "allowedVersions": "/^1\\.15\\.4-atlassian-\\d+$/",
      "description": "Only allow our 1.15.4-atlassian fork releases. Renovate otherwise proposes 1.15.10, which was released by mistake, while 1.15.4 is the latest upstream version we currently extend. Once 2.0 is released, this regex can be made generic again."
    },
    {
      "matchPackageNames": ["/^tools\\.jackson\\./"],
      "allowedVersions": "/^3\\.1\\./",
      "description": "Jackson 3.1.x is LTS (tools.jackson), do not bump to 3.2+."
    },
    {
      "description": "net.bytebuddy publishes a -jdk5 build of each release for pre-JDK8 environments. Maven ranks the unknown qualifier above the bare version, so Renovate offers 1.18.13-jdk5 in place of 1.18.13.",
      "matchPackageNames": ["net.bytebuddy:*"],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/"
    },
    {
      "description": "2.7.3-atlassian-hosted is a byte-identical rehost of 2.7.3 on packages.atlassian.com, still flagged as vulnerable by scanners. Maven ranks the unknown qualifier above the bare version, so Renovate offers it as a patch upgrade.",
      "matchPackageNames": ["xalan:xalan", "xalan:serializer"],
      "allowedVersions": "!/-atlassian-hosted$/"
    }
  ]
}
